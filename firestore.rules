rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    match /users/{userId} {

      // User hanya boleh baca profil sendiri buat masa ini.
      allow read: if isOwner(userId);

      // New user document:
      // identity + server-owned counters mesti bermula dengan nilai selamat.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'gender',
          'bio',
          'avatarPath',
          'authMethod',
          'birthdate',
          'hijriDOB',
          'followersCount',
          'followingCount',
          'postsCount',
          'treeLevel',
          'totalPoints',
          'currentStreak',
          'longestStreak',
          'lastActiveDate',
          'lastLogResetDate',
          'dailyFardhuLog',
          'dailyAmalanLog',
          'zikirDoneToday',
          'adhanModeIndex',
          'isFajrAlarmEnabled',
          'isDhuhrAlarmEnabled',
          'isAsrAlarmEnabled',
          'isMaghribAlarmEnabled',
          'isIshaAlarmEnabled',
          'zikirReminderEnabled',
          'themeMode'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authMethod is string
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.postsCount == 0
        && request.resource.data.treeLevel == 1
        && request.resource.data.totalPoints == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.longestStreak == 0;

      // User boleh ubah profile/settings tertentu.
      // Identity + counters/gamification stats tidak boleh berubah.
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'gender',
          'bio',
          'avatarPath',
          'authMethod',
          'birthdate',
          'hijriDOB',
          'followersCount',
          'followingCount',
          'postsCount',
          'treeLevel',
          'totalPoints',
          'currentStreak',
          'longestStreak',
          'lastActiveDate',
          'lastLogResetDate',
          'dailyFardhuLog',
          'dailyAmalanLog',
          'zikirDoneToday',
          'adhanModeIndex',
          'isFajrAlarmEnabled',
          'isDhuhrAlarmEnabled',
          'isAsrAlarmEnabled',
          'isMaghribAlarmEnabled',
          'isIshaAlarmEnabled',
          'zikirReminderEnabled',
          'themeMode'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'gender',
          'bio',
          'avatarPath',
          'birthdate',
          'hijriDOB',
          'lastActiveDate',
          'lastLogResetDate',
          'dailyFardhuLog',
          'dailyAmalanLog',
          'zikirDoneToday',
          'adhanModeIndex',
          'isFajrAlarmEnabled',
          'isDhuhrAlarmEnabled',
          'isAsrAlarmEnabled',
          'isMaghribAlarmEnabled',
          'isIshaAlarmEnabled',
          'zikirReminderEnabled',
          'themeMode'
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.authMethod == resource.data.authMethod;

      // Account deletion belum diimplementasikan melalui client.
      allow delete: if false;
    }

    match /posts/{postId} {

      allow read: if verified();

      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'type',
          'title',
          'content',
          'author',
          'authorId',
          'likes',
          'commentsCount',
          'assetPath',
          'category',
          'createdAt'
        ])
        && request.resource.data.type in ['article', 'quote']
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 120
        && request.resource.data.author ==
          (
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.name == ''
              ? 'Hamba Allah'
              : get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.name
          )
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 10
        && request.resource.data.content.size() <= 1000
        && request.resource.data.likes is int
        && request.resource.data.likes == 0
        && request.resource.data.commentsCount is int
        && request.resource.data.commentsCount == 0
        && (
          request.resource.data.assetPath == null
          || request.resource.data.assetPath is string
        )
        && (
          request.resource.data.category == null
          || request.resource.data.category is string
        )
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if verified()
        && resource.data.authorId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
